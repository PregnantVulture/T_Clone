{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build raylib Tetris",
            "command": "C:\\raylib\\w64devkit\\bin\\gcc.exe",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\tetris.exe",
                "-IC:\\raylib\\w64devkit\\include",
                "-LC:\\raylib\\w64devkit\\lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\raylib\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the raylib Tetris game using the raylib installer toolchain."
        }
    ],
    "version": "2.0.0"
}